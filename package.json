{
  "name": "angle-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs && vite build --config backoffice/vite.config.js",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --import ./backoffice/test/register.mjs --test --test-timeout=60000 backoffice/src/*.test.js backoffice/src/ui/*.test.js",
    "test:browser": "node --import ./backoffice/test/register.mjs --test --test-timeout=120000 backoffice/test/*.test.mjs",
    "test:no-browser": "ANGLE_BROWSER=optional npm test",
    "check:docs": "node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer": "^25.3.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
